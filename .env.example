# --- Browser (Vite) — set in Vercel for Preview/Production ---
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional reference ID (this repo does not read it in code; safe to omit)
# VITE_SUPABASE_PROJECT_ID=

# --- Server (SSR, server functions, auth middleware) — same values, no VITE_ prefix ---
# Vercel: duplicate VITE_* vars here or use Vercel’s “expose to server” as needed.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Admin client (server-only; never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=
