# Client (exposed to browser — use VITE_ prefix)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional: only if your tooling reads it (not required by this codebase)
# VITE_SUPABASE_PROJECT_ID=

# Server / SSR / server functions (set in Vercel → Environment Variables, not prefixed with VITE_)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
